{
  // markdownlint 配置 —— CLI（`pnpm lint:md`）与编辑器（VS Code 的 markdownlint 扩展）都读这份。
  // 只关掉与仓库既有风格 / prettier 打架的四条，其余保持默认：真问题（代码块没写语言、
  // 死链锚点、表格列数对不上……）继续报，也继续挡在 `pnpm check` 上。
  //
  // 为什么这四条是「关掉」而不是「修掉」：
  //   MD001 标题层级跳跃 —— 坑文件是 `# 一、属性（P1 / …）` + `### P<n>`，条目必须是 h3
  //                         （howto 守卫按 `### P<n>` 这个前缀找条目），h1 → h3 是有意为之
  //   MD013 行长         —— 宽度交给 prettier（printWidth 100 + 表格补空格）；
  //                         这里再卡一遍 80，两者会一直互相打架
  //   MD028 引用块内空行 —— 「读这份的场合 / 组件是最小单元」这类成对引块是有意分开的两块
  //   MD033 行内 HTML    —— 正文里点名 <doc-spec> / <mc-code> / <template page>，是内容不是噪音
  //
  // MD024 不是关掉，而是收紧成「同级唯一」：参考区按标签分小节，`### mc-radio-group`
  // 会在属性 / 事件 / 插槽 / part 四个 h2 下各出现一次 —— 分属不同父标题、不是同级重复，
  // 对应的正是这条规则「同一父级下标题不重名」的本意。
  "MD001": false,
  "MD013": false,
  "MD024": { "siblings_only": true },
  "MD028": false,
  "MD033": false
}
