{
  "name": "mosaic-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "基于 ofa.js 的免安装、免构建 Web Components UI 框架（手写工具类子集 + 三层 CSS 变量令牌）",
  "scripts": {
    "icons": "node tools/gen-icons.mjs",
    "tokens": "node tools/gen-tokens.mjs",
    "check:tokens": "node tools/gen-tokens.mjs --check",
    "check:docs": "node tools/doc-drift/drift.mjs",
    "build:css": "node tools/build-css.mjs",
    "build": "pnpm icons && pnpm tokens && pnpm build:css",
    "check:drift": "node tools/check-fresh.mjs",
    "check:size": "node tools/check-size.mjs",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "check": "pnpm typecheck && pnpm check:docs && pnpm check:drift && pnpm check:size && pnpm lint:md && pnpm format:check",
    "dev:css": "node tools/build-css.mjs --watch",
    "dev": "node tools/serve.mjs",
    "test": "node tests/smoke.mjs --changed",
    "test:all": "node tests/smoke.mjs",
    "test:site": "node tests/smoke.mjs --site",
    "test:changed": "node tests/smoke.mjs --changed",
    "test:record": "node tests/smoke.mjs --record",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.136",
    "@iconify/utils": "^3.1.7",
    "@types/node": "^26.6.1",
    "markdownlint-cli2": "^0.23.3",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2"
  }
}
