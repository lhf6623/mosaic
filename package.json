{
  "name": "mosaic-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "基于 ofa.js 的免安装、免构建 Web Components UI 框架（UnoCSS 原子化 + 三层 CSS 变量令牌）",
  "scripts": {
    "icons": "node tools/gen-icons.mjs",
    "tokens": "node tools/gen-tokens.mjs",
    "check:tokens": "node tools/gen-tokens.mjs --check",
    "build:css": "node tools/build-css.mjs",
    "build": "pnpm icons && pnpm tokens && pnpm build:css",
    "check:drift": "pnpm build && git diff --exit-code -- packages/color/tokens.css packages/boot/mosaic.css packages/icon/icons.generated.ts packages/icon/icons.license.txt",
    "dev:css": "node tools/build-css.mjs --watch",
    "dev": "node tools/serve.mjs",
    "test": "node tests/smoke.mjs",
    "test:site": "node tests/smoke.mjs --site",
    "test:changed": "node tests/smoke.mjs --changed",
    "test:record": "node tests/smoke.mjs --record",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.136",
    "@iconify/utils": "^3.1.7",
    "@types/node": "^26.6.1",
    "@unocss/cli": "^66.10.5",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "unocss": "^66.10.5"
  }
}
